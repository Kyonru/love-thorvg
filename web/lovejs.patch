diff --git a/src/love.cpp b/src/love.cpp
index 435ac90..da2bef6 100644
--- a/src/love.cpp
+++ b/src/love.cpp
@@ -47,6 +47,7 @@ extern "C" {
 
 #if LOVE_EMSCRIPTEN
 #include <emscripten.h>
+extern "C" void love_thorvg_register_web_module(lua_State *L);
 #endif
 
 #ifdef LOVE_WINDOWS
@@ -162,6 +163,10 @@ static DoneAction runlove(int argc, char **argv, int &retval)
 	lua_State *L = luaL_newstate();
 	luaL_openlibs(L);
 
+#if LOVE_EMSCRIPTEN
+	love_thorvg_register_web_module(L);
+#endif
+
 	// LuaJIT-specific setup needs to be done as early as possible - before
 	// get_app_arguments because that loads external library code. This is also
 	// loaded inside require("love"). Note that it doesn't use the love table.
@@ -225,8 +230,9 @@ static DoneAction runlove(int argc, char **argv, int &retval)
 	lua_call(L, 1, 1);
 
 	// Turn the returned boot function into a coroutine and call it until done.
-	lua_newthread(L);
+	lua_State *Lthread = lua_newthread(L);
 	lua_pushvalue(L, -2);
+	lua_xmove(L, Lthread, 1);
 	int nres;
         #ifdef LOVE_EMSCRIPTEN
         emscripten_set_main_loop_arg([](void *arg) {
@@ -238,7 +244,7 @@ static DoneAction runlove(int argc, char **argv, int &retval)
           } else {
             emscripten_cancel_main_loop();
 			};
-        }, (void *)L, 0, 1);
+        }, (void *)Lthread, 0, 1);
 	#else
         int stackpos = lua_gettop(L);
 	while (love::luax_resume(L, 0, &nres) == LUA_YIELD)
